# Conexión a PostgreSQL: usuario, clave, host, puerto y nombre de base
DATABASE_URL="postgresql://alpi:cambiar_esta_clave@localhost:5433/tienda_alpi?schema=public"

# Puerto de la API (el 3000 queda para Next.js)
PORT=3001

# URL del frontend (única web autorizada a llamar a la API)
URL_FRONTEND=http://localhost:3000

# Secretos para firmar los tokens: generalos con "openssl rand -base64 48"
JWT_SECRETO_ACCESO=generar_con_openssl
JWT_SECRETO_REFRESH=generar_con_openssl
